#!/usr/bin/env bash
# Pinned CUDA PyTorch runtime (torch 2.11 cu128) plus a venv with torchaudio and
# scikit-learn. Every cache and temporary file lives on the data disk.
# Configured for this NixOS host, not a portable installer.
set -euo pipefail
mountpoint -q /mnt/hd || { echo '/mnt/hd is not mounted; refusing artifact writes.' >&2; exit 1; }
code="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
art=/mnt/hd/localflow-speaker
mkdir -p "$art/tmp" "$art/cache"
export PYTHONPATH="$code${LFSPK_EXTRA_PYTHONPATH:+:$LFSPK_EXTRA_PYTHONPATH}${PYTHONPATH:+:$PYTHONPATH}"
export XDG_CACHE_HOME="$art/cache" TORCH_HOME="$art/cache/torch" TMPDIR="$art/tmp"
export HF_HOME="$art/cache/hf" HF_HUB_CACHE="$art/cache/hf/hub" PIP_CACHE_DIR="$art/cache/pip"
export HF_TOKEN_PATH="${HF_TOKEN_PATH:-$HOME/.cache/huggingface/token}"
export TRITON_CACHE_DIR="$art/cache/triton" TORCHINDUCTOR_CACHE_DIR="$art/cache/inductor"
export CUDA_CACHE_PATH="$art/cache/cuda" NUMBA_CACHE_DIR="$art/cache/numba"
export HF_HUB_DISABLE_TELEMETRY=1 DO_NOT_TRACK=1 WANDB_MODE=disabled TOKENIZERS_PARALLELISM=false
export PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS="${OMP_NUM_THREADS:-4}" MKL_NUM_THREADS="${MKL_NUM_THREADS:-4}"
export TRITON_LIBCUDA_PATH=/run/opengl-driver/lib
export LD_LIBRARY_PATH="/run/opengl-driver/lib:/nix/store/hngmi01i8wgi25a0byrxcn4ysz5j79mw-gcc-15.2.0-lib/lib:/nix/store/dbz6pb9g67kpgpl95k8d85kzpxm1c32p-zlib-1.3.2/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$art/venv/bin/python" "$@"
